# ==============================================================================
# Grist Core Configuration (.env.example)
# Salin file ini menjadi .env: cp .env.example .env
# Dokumentasi lengkap: https://support.getgrist.com/self-managed/
# ==============================================================================

# Port yang dibuka pada host mesin Anda
GRIST_PORT=8484

# ==============================================================================
# URL DASAR PUBLIK (PENTING UNTUK AKSES JARINGAN / PRODUCTION)
# ==============================================================================
# Jika hanya diakses dari komputer ini saja:
# APP_HOME_URL=http://localhost:8484
#
# Jika diakses melalui IP LAN / Server Kantor (contoh IP server: 192.168.1.215):
# APP_HOME_URL=http://192.168.1.215:8484
#
# Jika diakses melalui domain internet / Reverse Proxy:
# APP_HOME_URL=https://grist.domainanda.com
APP_HOME_URL=http://localhost:8484

# Kunci rahasia untuk menandatangani sesi cookie (Wajib diisi & unik)
# Bisa digenerate via: openssl rand -hex 32
GRIST_SESSION_SECRET=ganti_dengan_random_hex_32_karakter_misal_openssl_rand_hex_32

# Sandboxing formula Python.
# Opsi: 'gvisor' (rekomendasi, aman dan terisolasi), 'pyodide', atau 'unsandboxed'
GRIST_SANDBOX_FLAVOR=gvisor

# Nama organisasi / team site default.
TEAM=citiplumb

# ==============================================================================
# DAFTAR AKUN PENGGUNA & DEPARTEMEN (CITIPLUMB)
# Semua akun ini otomatis didaftarkan dan terhubung ke tim organisasi citiplumb
# ==============================================================================

# Akun Utama (Admin / IT)
EMAIL=admin@citiplumb.local
PASSWORD=AdminPass123!

# 1. Departemen Gudang Lokal
EMAIL2=gudang.lokal@citiplumb.local
PASSWORD2=GudangLokal123!

# 2. Departemen Gudang Impor
EMAIL3=gudang.impor@citiplumb.local
PASSWORD3=GudangImpor123!

# 3. Kepala Gudang
EMAIL4=kepala.gudang@citiplumb.local
PASSWORD4=KepalaGudang123!

# 4. Departemen PPIC
EMAIL5=ppic@citiplumb.local
PASSWORD5=PpicPass123!

# 5. Departemen Plating
EMAIL6=plating@citiplumb.local
PASSWORD6=PlatingPass123!

# 6. Departemen Injeksi
EMAIL7=injeksi@citiplumb.local
PASSWORD7=InjeksiPass123!

# 7. Departemen Spray
EMAIL8=spray@citiplumb.local
PASSWORD8=SprayPass123!

# 8. Departemen Assembly
EMAIL9=assembly@citiplumb.local
PASSWORD9=AssemblyPass123!

# ==============================================================================
# PENGATURAN UMUM & BRANDING (kiw-excel)
# ==============================================================================
GRIST_SERVE_SAME_ORIGIN=true
GRIST_TELEMETRY_LEVEL=off
GRIST_WIDGET_LIST_URL=https://github.com/gristlabs/grist-widget/releases/download/latest/manifest.json

# Tampilan kiw-excel (tema biru kustom)
APP_STATIC_INCLUDE_CUSTOM_CSS=true
GRIST_PAGE_TITLE_SUFFIX=" - kiw-excel"
GRIST_HIDE_UI_ELEMENTS=helpCenter,billing,templates,supportGrist

# ==============================================================================
# BACKUP OTOMATIS & EXTERNAL STORAGE
# ==============================================================================
# Jadwal cron (default: setiap hari jam 02:00 pagi)
BACKUP_CRON="0 2 * * *"

# Lama penyimpanan arsip backup (dalam hari)
BACKUP_RETENTION_DAYS=14

# Jalankan backup otomatis saat container pertama kali start
BACKUP_ON_STARTUP=true

# Lokasi folder backup di host (Bisa diarahkan ke harddisk eksternal / NAS mount: misal /mnt/hdd/backups)
BACKUP_DIR=./backups

# Zona waktu untuk jadwal backup
TZ=Asia/Jakarta

# Sinkronisasi Cloud Eksternal Rclone (Opsional: misal gdrive:kiw-excel-backups atau s3:my-bucket)
# Letakkan konfigurasi rclone di ./rclone.conf
RCLONE_REMOTE_DEST=

# ------------------------------------------------------------------------------
# NATIVE CLOUD SNAPSHOT STORAGE (AWS S3 / MinIO / Cloudflare R2) - Opsional
# ------------------------------------------------------------------------------
# GRIST_DOCS_MINIO_BUCKET=kiw-excel-backups
# GRIST_DOCS_MINIO_ENDPOINT=s3.us-east-1.amazonaws.com
# GRIST_DOCS_MINIO_PORT=443
# GRIST_DOCS_MINIO_ACCESS_KEY=your-access-key
# GRIST_DOCS_MINIO_SECRET_KEY=your-secret-key
# GRIST_DOCS_MINIO_USE_SSL=true
# GRIST_DOCS_MINIO_BUCKET_REGION=us-east-1
# GRIST_DOCS_MINIO_PREFIX=docs/

# ------------------------------------------------------------------------------
# EMAIL SMTP / NOTIFIKASI (Opsional - Menggunakan JSON Nodemailer)
# ------------------------------------------------------------------------------
# GRIST_NODEMAILER_CONFIG={"host":"smtp.mailgun.org","port":587,"secure":false,"auth":{"user":"postmaster@domain.com","pass":"secret"}}
# GRIST_NODEMAILER_SENDER="Grist Support <no-reply@domain.com>"

# ------------------------------------------------------------------------------
# AI FORMULA ASSISTANT (Opsional - OpenAI / OpenAI-compatible API)
# ------------------------------------------------------------------------------
# ASSISTANT_CHAT_COMPLETION_ENDPOINT=https://api.openai.com/v1/chat/completions
# ASSISTANT_API_KEY=sk-...
