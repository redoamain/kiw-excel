# ==============================================================================
# Grist Core Configuration (.env.example)
# Salin file ini menjadi .env: cp .env.example .env
# ==============================================================================

GRIST_PORT=8484
APP_HOME_URL=http://localhost:8484
GRIST_SESSION_SECRET=ganti_dengan_random_hex_32_karakter_misal_dari_openssl_rand_hex_32

GRIST_SANDBOX_FLAVOR=gvisor
GRIST_SINGLE_ORG=
GRIST_DEFAULT_EMAIL=admin@example.com
GRIST_FORCE_LOGIN=false
GRIST_SERVE_SAME_ORIGIN=true
GRIST_TELEMETRY_LEVEL=off
GRIST_WIDGET_LIST_URL=https://github.com/gristlabs/grist-widget/releases/download/latest/manifest.json

# Branding & Tema (kiw-excel)
APP_STATIC_INCLUDE_CUSTOM_CSS=true
GRIST_PAGE_TITLE_SUFFIX=" - kiw-excel"
GRIST_HIDE_UI_ELEMENTS=helpCenter,billing,templates,supportGrist

# Backup Otomatis & External Storage
BACKUP_CRON="0 2 * * *"
BACKUP_RETENTION_DAYS=14
BACKUP_ON_STARTUP=true
BACKUP_DIR=./backups
TZ=Asia/Jakarta
# RCLONE_REMOTE_DEST=gdrive:kiw-excel-backups

# Native Cloud S3 / MinIO / R2 Backup (Opsional)
# GRIST_DOCS_MINIO_BUCKET=kiw-excel-backups
# GRIST_DOCS_MINIO_ENDPOINT=s3.us-east-1.amazonaws.com
# GRIST_DOCS_MINIO_ACCESS_KEY=your-access-key
# GRIST_DOCS_MINIO_SECRET_KEY=your-secret-key

# SSO / OIDC (Opsional)
# GRIST_OIDC_SP_HOST=https://grist.domainanda.com
# GRIST_OIDC_IDP_ISSUER=https://auth.domainanda.com/application/o/grist/
# GRIST_OIDC_IDP_CLIENT_ID=grist-client-id
# GRIST_OIDC_IDP_CLIENT_SECRET=grist-client-secret

# Forward Auth (Opsional)
# GRIST_FORWARD_AUTH_HEADER=x-forwarded-user

# SMTP / Email (Opsional)
# GRIST_NODEMAILER_CONFIG={"host":"smtp.example.com","port":587,"secure":false,"auth":{"user":"user","pass":"pass"}}
# GRIST_NODEMAILER_SENDER="Grist <no-reply@example.com>"

# AI Assistant (Opsional)
# ASSISTANT_CHAT_COMPLETION_ENDPOINT=https://api.openai.com/v1/chat/completions
# ASSISTANT_API_KEY=sk-...
